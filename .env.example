# Copy to .env.local for local dev; set the same variables in Vercel for production.
# Supabase values: Dashboard → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional but recommended: a TMDB API key baked into the deployment gives EVERY
# user movies (search, watchlist, Top 10, MrWatch AI picks) without creating
# their own key. Create one free at themoviedb.org → Settings → API.
# A personal key pasted in Profile → Connections overrides this per device.
VITE_TMDB_API_KEY=
